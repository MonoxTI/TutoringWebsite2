# MongoDB
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/tutoring?retryWrites=true&w=majority

# Server
PORT=5000
NODE_ENV=production

# JWT
JWT_SECRET=your_long_random_secret_here

# Email (nodemailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=your@gmail.com
EMAIL_PASS=your_app_password_here

# Frontend URL (used for CORS - set to your Vercel deployment URL)
FRONTEND_URL=https://your-app.vercel.app

# Vite (frontend) - set in Vercel dashboard under Environment Variables
VITE_API_URL=https://your-app.vercel.app
